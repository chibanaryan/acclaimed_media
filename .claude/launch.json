// The Claude desktop app's preview server: Conductor's Run button
// (.conductor/settings.toml), for the main checkout and every worktree.
// autoPort gives each session a free port and passes it as $PORT, as
// setup_worktree.sh --print-port does for Conductor. The preview opens the
// landing page; its links reach games.localhost and music.localhost on the
// same port.
{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "django",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "exec venv/bin/python manage.py runserver \"${PORT:-8000}\""
      ],
      "env": {
        "DEBUG": "True"
      },
      "port": 8000,
      "autoPort": true
    }
  ]
}
