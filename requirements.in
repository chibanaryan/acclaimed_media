# What production imports. Edit this file, not requirements.txt, then:
#   pip-compile requirements.in && pip-compile requirements-dev.in
# requirements.txt is the pinned lock Heroku installs. Dev and test tools
# live in requirements-dev.in. See "Keeping dependencies current" in AGENTS.md.

django
django-allauth[socialaccount]
django-cors-headers
django-environ
# In INSTALLED_APPS unconditionally, so it is a runtime dependency.
django-extensions
django-tailwind
djangorestframework
gunicorn
psycopg2-binary
sentry-sdk[django]
whitenoise
# WhiteNoise's compressed static files at collectstatic.
Brotli

# Imported directly by refresh_all_metadata's Wikipedia pass, so named here:
# it was pinned only as howlongtobeatpy's dependency, and would have gone
# with it.
aiohttp
beautifulsoup4
howlongtobeatpy
markdown
requests
unidecode
