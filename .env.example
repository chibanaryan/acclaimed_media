# =============================================================================
# Django Settings
# =============================================================================

# Enable Django debug mode (enables template reloading, detailed error pages)
DEBUG=True

# Django secret key (required in production - generate a secure random key)
SECRET_KEY=your-secret-key-here

# =============================================================================
# Database (optional - defaults to SQLite)
# =============================================================================

# PostgreSQL connection URL for production
# Example: postgres://user:password@host:5432/dbname
# DATABASE_URL=

# Run the test suites on Postgres rather than in-memory SQLite, as CI's
# django-tests job does
# TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/acclaimed

# =============================================================================
# IGDB API (required for game metadata)
# =============================================================================

# Get credentials at https://api-docs.igdb.com/
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Enable IGDB Pro tier for higher rate limits (default: False)
IGDB_USE_PRO_TIER=False

# =============================================================================
# Wikipedia/Wikidata (optional - improves rate limits)
# =============================================================================

# A Wikimedia BotPassword, as user:password, for faster Wikipedia processing
# (sent as basic auth; not an OAuth token)
# See https://www.wikidata.org/wiki/Wikidata:Creating_a_bot for setup
# WIKIDATA_ACCESS_TOKEN=

# =============================================================================
# Feature Flags
# =============================================================================

# Show the Books links in the nav (default: False). The section is staff-only
# whatever this says
# BOOKS_ENABLED=False

# =============================================================================
# Books Integrations (optional)
# =============================================================================

# Hardcover GraphQL API token for additional book metadata
# HARDCOVER_API_TOKEN=

# =============================================================================
# Music Integrations (optional)
# =============================================================================

# Discogs personal access token. Raises the music metadata fetch above the
# anonymous 25 requests a minute. https://www.discogs.com/settings/developers
# DISCOGS_TOKEN=

# =============================================================================
# Imports (optional)
# =============================================================================

# Whether an import fetches the metadata it left missing (default: on)
# METADATA_AFTER_IMPORT=True

# =============================================================================
# Error Tracking (optional)
# =============================================================================

# Sentry DSN for error tracking in production
# SENTRY_DSN=
# Sentry environment tag. Defaults to "production" on Heroku (DYNO is set)
# and "development" everywhere else. "development" sends nothing, even with a
# DSN; set any other value to opt a machine in.
# SENTRY_ENVIRONMENT=

# =============================================================================
# Email (optional - required for production contact/password reset emails)
# =============================================================================

# Brevo SMTP username (not secret)
# BREVO_SMTP_USER=

# Brevo SMTP API key/password
# BREVO_SMTP_KEY=

# The origin emailed links are built on where no request is at hand.
# Defaults to http://localhost:8000 under DEBUG, else the public apex
# SITE_URL=

# =============================================================================
# Cache (optional - local memory under DEBUG and under test, else a file cache)
# =============================================================================

# The shared cache. Production uses Django's database cache on Postgres.
# Under DEBUG an unset or dbcache URL is local memory; any other URL is used
# Example: dbcache://cache_table
# CACHE_URL=

# =============================================================================
# Rate limits (optional)
# =============================================================================

# Answer 429 to anonymous page renders past each worker's budget, which
# otherwise only reports them (default: False). See "Caching" in AGENTS.md
# ANON_RENDER_BUDGET_ENFORCE=False

# =============================================================================
# CORS (optional - for API access from other domains)
# =============================================================================

# Comma-separated list of allowed origins
# CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
