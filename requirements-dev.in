# Local development and tests, on top of production's pins.
#   pip install -r requirements.txt -r requirements-dev.txt
-c requirements.txt
-r requirements.in

# Tests. tblib lets `manage.py test --parallel` report an unpicklable
# traceback instead of crashing the runner.
coverage
pytest
pytest-cov
pytest-django
pytest-xdist
tblib

# Lint and hooks. black and flake8 also run from .pre-commit-config.yaml at
# the revs pinned there.
pre-commit

# Dependency upkeep: /upgrade-deps.
pip-audit
pip-tools

# Loaded only when DEBUG is on (settings.py, urls.py).
django-debug-toolbar
# shell_plus, and runserver_plus over HTTPS.
ipython
pyOpenSSL
Werkzeug
