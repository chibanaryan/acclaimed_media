[run]
source = games,books,core,music
omit =
    */migrations/*
    */tests/*
    */management/commands/*
    games/services/import_handler.py
    music/services/import_handler.py

[report]
exclude_lines =
    pragma: no cover
    def __repr__
    raise NotImplementedError
    if __name__ == .__main__.:
    warnings.warn
